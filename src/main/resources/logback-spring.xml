<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <conversionRule conversionWord="safeMessage" class="kz.studhub.config.SafeLogMessage"/>
    <springProperty name="redactDbUrl" source="spring.datasource.url" scope="context" defaultValue=""/>
    <springProperty name="redactDbPassword" source="spring.datasource.password" scope="context" defaultValue=""/>
    <springProperty name="redactAdminPassword" source="studhub.admin.password" scope="context" defaultValue=""/>
    <springProperty name="redactTwoFactorKey" source="studhub.security.key" scope="context" defaultValue=""/>
    <springProperty name="redactGeminiKey" source="studhub.ai.gemini-api-key" scope="context" defaultValue=""/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{45} - %safeMessage%n%nopex"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
